  FILE = {/mnt/collection/zoterolibrary/storage/MCAHG3KN/Mathiesen et al. - 2009 - Uncertainties related to the identification of the marginal energy technology in consequential life cycle asse.pdf},
  ISBN = {0959-6526},
  ISSN = {09596526},
  JOURNALTITLE = {Journal of Cleaner Production},
  KEYWORDS = {Consequential life cycle inventory analysis,consequential_LCA,Energy system analyses,marginal,Methodology,Modelling,Waste incineration},
  NUMBER = {15},
  PAGES = {1331--1338},
  TITLE = {Uncertainties Related to the Identification of the Marginal Energy Technology in Consequential Life Cycle Assessments},
