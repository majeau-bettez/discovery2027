  ISSN = {1095-9203},
  JOURNALTITLE = {Science},
  KEYWORDS = {analyzing uncertainty,consumption,Economics,Economics: trends,environmental impacts,fresh-water,global-scale,human health,impact assessment,inventory,land-use,lca,Manufactured Materials,Manufactured Materials: supply & distribution,Science & Technology - Other Topics,Transportation,Transportation: economics},
  NUMBER = {6188},
